# rag-kb 环境变量模板
# 复制为 .env 并填入真实值(.env 已在 .gitignore 中)
# Spring Boot 会自动加载 .env 中的环境变量(Spring Boot 3.3+)

DB_URL=jdbc:postgresql://localhost:5432/ragkb
DB_USERNAME=ragkb
DB_PASSWORD=your_db_password_here

JWT_SECRET=your_jwt_secret_at_least_32_bytes_here

RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=your_ragflow_api_key_here
