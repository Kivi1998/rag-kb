# 复制为 .env 后由密钥管理系统覆盖；不要提交真实值。
PARSER_API_KEY=replace-with-at-least-32-random-characters
PARSER_BIND_ADDRESS=127.0.0.1
PARSER_PORT=8081
PARSER_MAX_FILE_BYTES=2147483648
PARSER_MAX_CONCURRENCY=2
PARSER_WHISPER_MODEL=small
PARSER_WHISPER_DEVICE=cpu
PARSER_WHISPER_COMPUTE_TYPE=int8
PARSER_PRELOAD_WHISPER=true
PARSER_REQUIRE_ASR_READY=true
PARSER_CPU_LIMIT=4.0
PARSER_MEMORY_LIMIT=8g
PARSER_TMPFS_SIZE=4g
